<!doctype html>
<html class="no-js" lang="en">

<head>
  <meta charset="utf-8">
  <meta http-equiv="x-ua-compatible" content="ie=edge">
  <title>{{basics.name}} — Resume</title>
  <meta name="description" content="">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700|Open+Sans" rel="stylesheet">
  <link rel="manifest" href="site.webmanifest">

  <style>
    @page { size: A4; margin: 10mm; }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: 'Montserrat', sans-serif; font-size: 9pt; line-height: 1.13; color: #202020; }
    a { color: inherit; text-decoration: none; }
    header { padding: 3mm 0 7pt; margin-bottom: 9pt; border-bottom: 0.6pt solid #d5d5d5; }
    h1 { margin: 0 0 4pt; font-size: 23pt; line-height: 1; text-transform: uppercase; }
    h2 { margin: 0 0 9pt; font-size: 10.5pt; }
    .header__links { display: flex; flex-wrap: wrap; gap: 6pt 16pt; margin: 0; padding: 0; list-style: none; font-size: 8.5pt; }
    .header__links + .header__links { margin-top: 6pt; }
    .header__links a { white-space: nowrap; text-decoration: underline; text-decoration-color: #aaa; text-underline-offset: 2pt; }
    h3 { margin: 10pt 0 5pt; font-size: 11.5pt; text-transform: uppercase; break-after: avoid; }
    .about p { margin: 0; }
    .work-experience__item { margin: 0 0 10pt; break-inside: avoid; }
    .work-experience__item__title, .education__item__title { font-size: 10pt; font-weight: 700; }
    .work-experience__item__dates { margin-top: 2pt; font-size: 8pt; color: #666; }
    .work-experience__item__description { margin: 5pt 0; }
    .work-experience__item__stack { font-size: 8pt; line-height: 1.15; color: #555; }
    .work-experience__item__stack span { font-weight: 700; }
    .work-experience__item__stack ul { display: inline; padding: 0; margin: 0; list-style: none; }
    .work-experience__item__stack li { display: inline; }
    .work-experience__item__stack li:not(:last-child)::after { content: '; '; }
    .skills__item__title { margin-top: 7pt; font-weight: 700; }
    .skills__item ul { margin: 3pt 0 6pt; padding: 0; list-style: none; }
    .skills__item ul li { display: inline; }
    .skills__item ul li:not(:last-child)::after { content: '; '; }
    .work-experience__item:nth-of-type(4) { break-before: page; padding-top: 10mm; }
    .education__item { break-inside: avoid; }
    .education__item__dates, .education__item__gpa { margin-top: 3pt; font-size: 8pt; color: #555; }
    .languages p { margin: 0; }
    .interests { display: none; }
  </style>
</head>

<body>
  <header>
    <h1>{{basics.name}}</h1>
    <h2>{{basics.label}}</h2>
    <ul class="header__links">
      <li><a href="mailto:{{basics.email}}">{{basics.email}}</a></li>
      <li><a href="{{basics.website}}">mansur.expert</a></li>
      <li><a href="https://t.me/{{basics.telegram}}">Telegram: @{{basics.telegram}}</a></li>
    </ul>
    <ul class="header__links">
      {{#basics.profiles}}
      <li><a href="{{url}}">{{network}}</a></li>
      {{/basics.profiles}}
    </ul>
  </header>
  <section class="about">
    <h3 class="about__title">About</h3>
    <p>{{&basics.summary}}</p>
  </section>
  <section class="work-experience">
    <h3 class="work-experience__title">Work experience</h3>
    {{#work}}
      <div class="work-experience__item">
        <div class="work-experience__item__title">{{position}},
          {{#website}}<a target='_blank' href="{{website}}">{{company}}</a>{{/website}}
          {{^website}}<span>{{company}}</span>{{/website}}
        </div>
        <div class="work-experience__item__dates">
          {{startDate}}
          {{#endDate}} - {{endDate}}{{/endDate}}
        </div>
        <div class="work-experience__item__description">{{&summary}}</div>
        <div class="work-experience__item__stack">
          <span>Technologies</span>
          <ul>
            {{#stack}}
              <li>{{.}}</li>
            {{/stack}}
          </ul>
        </div>
      </div>
    {{/work}}
  </section>
  {{#certifications.length}}
  <section class="certifications">
    <h3 class="certifications__title">Certifications</h3>
    {{#certifications}}
    <div class="certifications__item">
      <div class="certifications__item__title"><a target='_blank' href="{{url}}">{{title}}</a></div>
      <div class="certifications__item__dates">{{dates}}</div>
    </div>
    {{/certifications}}
  </section>
  {{/certifications.length}}
  <section class="skills">
    <h3 class="skills__title">Skills</h3>
    <div class="skills__item">
      {{#skills}}
        <div class="skills__item__title">{{name}}</div>
        <ul>
          {{#keywords}}
            <li>{{.}}</li>
          {{/keywords}}
        </ul>
      {{/skills}}
    </div>
  </section>
  {{#languages.length}}
  <section class="languages">
    <h3>Languages</h3>
    {{#languages}}<p>{{language}}: {{fluency}}</p>{{/languages}}
  </section>
  {{/languages.length}}
  <section class="education">
    <h3 class="education__title">Education</h3>
    {{#education}}
    <div class="education__item">
      <div class="education__item__title">{{studyType}}, {{area}} - {{institution}}</div>
      <div class="education__item__dates">{{startDate}} – {{endDate}}</div>
      <div class="education__item__gpa">GPA: {{gpa}}</div>
    </div>
    {{/education}}
  </section>
  <section class="interests">
    <h3 class="interests__title">Interests</h3>
    <div class="interests__item">
      {{#interests}}
        <div class="interests__item__title">{{name}}</div>
        <ul>
          {{#keywords}}
            <li>{{.}}</li>
          {{/keywords}}
        </ul>
      {{/interests}}
    </div>
  </section>
  <footer>
  </footer>

  <script src="js/app.min.js"></script>
</body>

</html>
